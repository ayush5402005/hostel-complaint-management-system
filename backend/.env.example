# ============================================
# DATABASE
# Special characters in the password must be URL-encoded (@ -> %40)
# ============================================
DATABASE_URL="mysql://root:YOUR_DB_PASSWORD@localhost:3306/hostel_db"

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=8080

# ============================================
# JWT — rotate this before any real deployment
# ============================================
JWT_SECRET=my-super-secret-key-my-super-secret-key-12345
JWT_EXPIRES_IN_MS=3600000

# ============================================
# FILE UPLOAD — Cloudinary (get these from cloudinary.com/console)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# MAIL (Gmail SMTP) — use a Gmail App Password, not your account password
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Base URL of the deployed frontend's reset-password page (used in reset emails)
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# ============================================
# CORS — comma-separated list of allowed frontend origins
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
